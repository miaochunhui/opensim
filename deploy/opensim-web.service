[Unit]
Description=OpenSim Fluid FEM Workbench
After=network.target

[Service]
Type=simple
User=infra
Group=infra
WorkingDirectory=/data/dev/opensim
ExecStart=/usr/bin/python3 -B /data/dev/opensim/server.py --host 192.168.1.30 --port 8772 --evidence /hf3fs-jd/data/tmp/opensim-fluid-v1/local-v2/numerics.json --log-dir /hf3fs-jd/data/tmp/opensim-fluid-v1/logs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/hf3fs-jd/data/tmp/opensim-fluid-v1/logs
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
MemoryMax=512M
TasksMax=32
UMask=0027

[Install]
WantedBy=multi-user.target
